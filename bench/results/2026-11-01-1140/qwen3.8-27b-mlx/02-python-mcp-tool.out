

import sqlite3
from typing import Optional


def search_cases(query: str, limit: int = 10) -> list[dict]:
    conn: Optional[sqlite3.Connection] = None
    try:
        conn = sqlite3.connect("cases.db")
        conn.row_factory = sqlite3.Row
        cursor: sqlite3.Cursor = conn.cursor()

        escaped_query: str = (
            query.replace("\\", "\\\\")
                 .replace("%", "\\%")
                 .replace("_", "\\_")
        )
        pattern: str = f"%{escaped_query}%"

        cursor.execute(
            """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE (citation LIKE ? ESCAPE '\\' OR summary LIKE ? ESCAPE '\\')
            ORDER BY year DESC
            LIMIT ?
            """,
            (pattern, pattern, limit),
        )

        rows: list[sqlite3.Row] = cursor.fetchall()
        results: list[dict] = [dict(row) for row in rows]
        return results
    finally:
        if conn is not None:
            conn.close()