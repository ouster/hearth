```python
import sqlite3
from typing import List, Dict

def search_cases(query: str, limit: int = 10) -> list[dict]:
    """Search cases in the local SQLite database."""
    conn = None
    try:
        conn = sqlite3.connect("cases.db")
        cursor = conn.cursor()
        sql = """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE lower(citation) LIKE ? OR lower(summary) LIKE ?
            ORDER BY year DESC
            LIMIT ?
        """
        pattern = f"%{query.lower()}%"
        cursor.execute(sql, (pattern, pattern, limit))
        rows = cursor.fetchall()
        columns = [col[0] for col in cursor.description]
        results: List[Dict[str, object]] = [
            {columns[i]: row[i] for i in range(len(columns))}
            for row in rows
        ]
        return results
    finally:
        if conn is not None:
            conn.close()
```