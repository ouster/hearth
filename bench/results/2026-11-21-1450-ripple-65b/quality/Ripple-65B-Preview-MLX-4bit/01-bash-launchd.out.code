#!/usr/bin/env bash
set -euo pipefail

LABEL="com.example.service"
PLIST="${HOME}/Library/LaunchAgents/${LABEL}.plist"

if [[ ! -f "$PLIST" ]]; then
    printf 'Error: plist not found at %s\n' "$PLIST" >&2
    exit 1
fi

if ! launchctl print-user "${LABEL}" &>/dev/null; then
    if ! launchctl bootstrap user "${LABEL}"; then
        printf 'Error: failed to load %s\n' "$LABEL" >&2
        exit 1
    fi
    printf 'Loaded %s\n' "$LABEL"
else
    printf '%s is already loaded\n' "$LABEL"
fi

exit 0
