import sqlite3
from typing import Any, Optional

def search_cases(query: str, limit: int = 10) -> list[dict]:
    conn: Optional[sqlite3.Connection] = None
    try:
        conn = sqlite3.connect("cases.db")
        cursor: sqlite3.Cursor = conn.cursor()
        
        sql: str = """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE citation LIKE ? COLLATE NOCASE 
               OR summary LIKE ? COLLATE NOCASE
            ORDER BY year DESC
            LIMIT ?
        """
        
        pattern: str = f"%{query}%"
        params: tuple[str, str, int] = (pattern, pattern, limit)
        
        cursor.execute(sql, params)
        rows: list[tuple] = cursor.fetchall()
        
        if cursor.description is None:
            return []
            
        columns: list[str] = [desc[0] for desc in cursor.description]
        results: list[dict[str, Any]] = [dict(zip(columns, row)) for row in rows]
        
        return results
    finally:
        if conn is not None:
            conn.close()
