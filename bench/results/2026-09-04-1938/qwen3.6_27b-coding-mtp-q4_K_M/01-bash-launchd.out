```bash
#!/usr/bin/env bash
set -euo pipefail

SERVICE_LABEL="com.example.service"
PLIST_PATH="$HOME/Library/LaunchAgents/${SERVICE_LABEL}.plist"

if [ ! -f "$PLIST_PATH" ]; then
    echo "Error: Plist file not found at ${PLIST_PATH}" >&2
    exit 1
fi

if launchctl list "$SERVICE_LABEL" >/dev/null 2>&1; then
    echo "Service ${SERVICE_LABEL} is already loaded."
else
    launchctl load "$PLIST_PATH"
    echo "Service ${SERVICE_LABEL} loaded successfully."
fi
```