import sqlite3
from typing import List, Dict


def search_cases(query: str, limit: int = 10) -> List[Dict]:
    """Search the `cases` table for rows where `citation` or `summary`
    contains the given query string (case‑insensitive). Results are ordered
    by year descending and limited to `limit` entries."""
    conn = None
    try:
        conn = sqlite3.connect("cases.db")
        conn.row_factory = sqlite3.Row
        cursor = conn.cursor()

        sql = """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE citation LIKE ? COLLATE NOCASE
               OR summary   LIKE ? COLLATE NOCASE
            ORDER BY year DESC
            LIMIT ?
        """

        like_pattern = f"%{query}%"
        cursor.execute(sql, (like_pattern, like_pattern, limit))
        rows = cursor.fetchall()

        return [dict(row) for row in rows]
    finally:
        if conn is not None:
            conn.close()
