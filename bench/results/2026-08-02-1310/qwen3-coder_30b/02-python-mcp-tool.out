```python
import sqlite3
from typing import list, dict

def search_cases(query: str, limit: int = 10) -> list[dict]:
    conn = None
    try:
        conn = sqlite3.connect('cases.db')
        cursor = conn.cursor()
        
        cursor.execute('''
            SELECT id, citation, court, year, summary 
            FROM cases 
            WHERE LOWER(citation) LIKE LOWER(?) 
            OR LOWER(summary) LIKE LOWER(?)
            ORDER BY year DESC
            LIMIT ?
        ''', (f'%{query}%', f'%{query}%', limit))
        
        columns = ['id', 'citation', 'court', 'year', 'summary']
        results = [dict(zip(columns, row)) for row in cursor.fetchall()]
        
        return results
        
    except sqlite3.Error as e:
        raise e
    finally:
        if conn:
            conn.close()
```