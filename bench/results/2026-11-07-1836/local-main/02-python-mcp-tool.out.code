import sqlite3

def search_cases(query: str, limit: int = 10) -> list[dict]:
    conn: sqlite3.Connection = sqlite3.connect("cases.db")
    try:
        cursor: sqlite3.Cursor = conn.cursor()
        pattern: str = f"%{query}%"
        cursor.execute(
            """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE LOWER(citation) LIKE LOWER(?)
               OR LOWER(summary) LIKE LOWER(?)
            ORDER BY year DESC
            LIMIT ?
            """,
            (pattern, pattern, limit),
        )
        rows: list[tuple] = cursor.fetchall()
        return [
            {
                "id": row[0],
                "citation": row[1],
                "court": row[2],
                "year": row[3],
                "summary": row[4],
            }
            for row in rows
        ]
    finally:
        conn.close()
