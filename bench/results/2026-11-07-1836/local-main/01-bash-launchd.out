```bash
#!/usr/bin/env bash
set -euo pipefail

PLIST="$HOME/Library/LaunchAgents/com.example.service.plist"
LABEL="com.example.service"

if [ ! -f "$PLIST" ]; then
    echo "Error: Plist file does not exist: $PLIST" >&2
    exit 1
fi

if launchctl list "$LABEL" >/dev/null 2>&1; then
    echo "$LABEL is already loaded."
    exit 0
fi

echo "Loading $LABEL..."
launchctl load "$PLIST"
```