```python
import sqlite3

def search_cases(query: str, limit: int = 10) -> list[dict]:
    connection = sqlite3.connect("cases.db")
    try:
        cursor = connection.cursor()
        search_pattern = f"%{query}%"
        sql = """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE citation LIKE ? OR summary LIKE ?
            ORDER BY year DESC
            LIMIT ?
        """
        cursor.execute(sql, (search_pattern, search_pattern, limit))
        
        column_names = [column[0] for column in cursor.description]
        return [dict(zip(column_names, row)) for row in cursor.fetchall()]
    finally:
        connection.close()
```