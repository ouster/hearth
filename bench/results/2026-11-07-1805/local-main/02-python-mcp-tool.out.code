import sqlite3
from typing import Optional

def search_cases(query: str, limit: int = 10) -> list[dict]:
    conn: Optional[sqlite3.Connection] = None
    try:
        conn = sqlite3.connect("cases.db")
        cursor = conn.cursor()
        pattern: str = f"%{query}%"
        sql: str = """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE LOWER(citation) LIKE LOWER(?) OR LOWER(summary) LIKE LOWER(?)
            ORDER BY year DESC
            LIMIT ?
        """
        cursor.execute(sql, (pattern, pattern, limit))
        rows = cursor.fetchall()
        
        if not rows:
            return []
            
        return [
            {"id": row[0], "citation": row[1], "court": row[2], "year": row[3], "summary": row[4]}
            for row in rows
        ]
    except Exception:
        return []
    finally:
        if conn is not None:
            conn.close()
