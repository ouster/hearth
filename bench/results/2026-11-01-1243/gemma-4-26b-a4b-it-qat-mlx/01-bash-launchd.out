```bash
#!/bin/bash

set -euo pipefail

SERVICE_NAME="com.example.service"
PLIST_PATH="$HOME/Library/LaunchAgents/${SERVICE_NAME}.plist"

if [[ ! -f "$PLIST_PATH" ]]; then
    echo "Error: Plist file not found at $PLIST_PATH" >&2
    exit 1
fi

# Check if the service is already loaded using launchctl list
# We use grep to check for the specific label in the output
if launchctl list | grep -q "${SERVICE_NAME}"; then
    echo "Service ${SERVICE_NAME} is already loaded."
else
    echo "Service ${SERVICE_NAME} is not loaded. Loading now..."
    launchctl load "$PLIST_PATH"
    echo "Service ${SERVICE_NAME} loaded successfully."
fi
```