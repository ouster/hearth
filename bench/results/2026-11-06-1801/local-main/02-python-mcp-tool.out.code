import sqlite3

def search_cases(query: str, limit: int = 10) -> list[dict]:
    """
    Queries the local SQLite database for cases matching the query string
    in either the citation or summary columns.
    """
    db_path: str = "cases.db"
    search_term: str = f"%{query}%"
    sql: str = """
        SELECT id, citation, court, year, summary
        FROM cases
        WHERE citation LIKE ? OR summary LIKE ?
        ORDER BY year DESC
        LIMIT ?
    """
    
    connection: sqlite3.Connection | None = None
    results: list[dict] = []
    
    try:
        connection = sqlite3.connect(db_path)
        connection.row_factory = sqlite3.Row
        cursor = connection.cursor()
        
        cursor.execute(sql, (search_term, search_term, limit))
        rows = cursor.fetchall()
        
        results = [dict(row) for row in rows]
        
    except sqlite3.Error:
        raise
    finally:
        if connection is not None:
            connection.close()
            
    return results