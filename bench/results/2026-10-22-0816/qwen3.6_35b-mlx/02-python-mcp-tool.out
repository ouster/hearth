```python
import sqlite3

def search_cases(query: str, limit: int = 10) -> list[dict]:
    conn = sqlite3.connect("cases.db")
    try:
        cursor = conn.cursor()
        param = f"%{query}%"
        cursor.execute(
            """
            SELECT id, citation, court, year, summary
            FROM cases
            WHERE citation LIKE ? COLLATE NOCASE
               OR summary LIKE ? COLLATE NOCASE
            ORDER BY year DESC
            LIMIT ?
            """,
            (param, param, limit)
        )
        rows = cursor.fetchall()
        columns: list[str] = ["id", "citation", "court", "year", "summary"]
        return [dict(zip(columns, row)) for row in rows]
    finally:
        conn.close()
```