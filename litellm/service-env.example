# ---------------------------------------------------------------------------
# SERVICE env — template for ~/.config/litellm/env
#
# This is the ONLY file launchd feeds the gateway. run-litellm.sh sources it
# before exec'ing litellm. It reads neither ~/.zshrc nor the repo's .env, so
# anything the gateway needs must be here.
#
# Do not copy this over your existing ~/.config/litellm/env — that file already
# has real values. Use it as a checklist of what belongs there.
#
# A model whose os.environ/ var is missing fails the ENTIRE config load, not
# just that model. Add the key before uncommenting a dormant role.
# ---------------------------------------------------------------------------

# Gateway admin key. Conventionally sk-prefixed; any string works.
# Previously hardcoded in config.yaml — moved here so config can be committed.
export LITELLM_MASTER_KEY=CHANGEME

# Password must match POSTGRES_PASSWORD in the repo .env.
export DATABASE_URL=postgresql://litellm:CHANGEME@127.0.0.1:5433/litellm

# ---- providers: only what you actually have ----
export GOOGLE_API_KEY=CHANGEME          # cloud-cheap. Live.

# Dormant until the matching role is uncommented in config.yaml:
# export ANTHROPIC_API_KEY=CHANGEME     # cloud-code. Bills separately from a
#                                       # Claude subscription — the subscription
#                                       # cannot be used via API.
# export OPENROUTER_API_KEY=CHANGEME    # cloud-frontier. Primary frontier route.
# export MOONSHOT_API_KEY=CHANGEME      # cloud-frontier-direct.
# export FIREWORKS_API_KEY=CHANGEME     # cloud-frontier-fast. Dearest.

# ---- local ----
export OLLAMA_API_BASE=http://127.0.0.1:11434
export OLLAMA_MODELS=/Users/Shared/Ollama/models
