# Copy to .env and fill. .env is gitignored — never commit the real one.
# Sourced by run-litellm.sh and docker compose.

# ---- gateway ----
LITELLM_MASTER_KEY=sk-...            # admin. Was hardcoded in the old config.yaml.
DATABASE_URL=postgresql://litellm:CHANGEME@127.0.0.1:5433/litellm
POSTGRES_PASSWORD=CHANGEME           # must match the password in DATABASE_URL

# ---- providers ----
GOOGLE_API_KEY=AIza...               # cloud-cheap. Already wired.
ANTHROPIC_API_KEY=sk-ant-...         # cloud-code.
OPENROUTER_API_KEY=sk-or-...         # cloud-frontier PRIMARY. One key, many models.
MOONSHOT_API_KEY=sk-...              # cloud-frontier-direct. Optional.
FIREWORKS_API_KEY=fw_...             # cloud-frontier-fast. Optional, dearest.

# ---- local ----
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_MODELS=/Users/Shared/Ollama/models

# ---- virtual keys, populated by scripts/create-keys.sh ----
LITELLM_PRIVATE_KEY=
LITELLM_GENERAL_KEY=
LITELLM_LAN_KEY=
LITELLM_ROAM_KEY=
