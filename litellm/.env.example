# ---------------------------------------------------------------------------
# REPO env — read by scripts/*.sh ONLY. Never by the gateway.
#
#   cp litellm/.env.example litellm/.env
#
# Provider keys and LITELLM_MASTER_KEY do NOT belong here. They go in the
# service env — see litellm/service-env.example. launchd reads only that file,
# so a provider key placed here would look set to you and be missing to the
# gateway.
#
# Gitignored. Never commit the filled-in version.
# ---------------------------------------------------------------------------

# Used by scripts/db.sh to start Postgres. Must match the password embedded in
# DATABASE_URL in the service env.
POSTGRES_PASSWORD=CHANGEME

# Written by scripts/create-keys.sh. Paste the four values it prints.
# Used by healthcheck.sh (leak test) and by aliases.zsh to pick a scope.
LITELLM_PRIVATE_KEY=
LITELLM_GENERAL_KEY=
LITELLM_LAN_KEY=
LITELLM_LAN_CLOUD_KEY=
